NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://alfa:alfa_local_only@127.0.0.1:5432/alfa
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=alfa
DEV_AUTH=false
# Development only: explicitly allow paid calls without gateway cap validation or budget reservation.
ALLOW_UNCAPPED_LLM=false
# disabled serves actual data and existing insights; new analysis returns 503 before queueing.
# langgraph enables paid agent runs after gateway configuration.
# fixture is an explicit isolated test mode, prohibited in production.
AGENT_PROVIDER=disabled
# Dataset accounts and custom registrations are stored in PostgreSQL.
# Legacy service bearer accounts are optional.
AUTH_USERS_JSON=[]
# pnpm db:seed generates a persistent secret in .env; set explicitly in production.
AUTH_SESSION_SECRET=
# Published dataset passwords: allowed by default in development/test, denied in production.
# ALLOW_DATASET_LOGIN=true
# Defaults to repository data/ for host execution; use /app/data in Compose.
# DATA_DIR=/absolute/path/to/data
DAILY_BUDGET_RUB=500
RUN_RESERVATION_RUB=25
RUN_TIMEOUT_MS=180000
RUN_MAX_RECOVERIES=2
RANKING_LIMIT=10
# Optional cap on feed cards out of RANKING_LIMIT analysed events, events with risks or opportunities first.
# Unset shows every event that passed the checks.
# FEED_CARDS=5
# Extra model call that checks AI conclusions; needs reserve for AGENT_MAX_STEPS + 3 calls.
AGENT_VERIFY=false
# Worker refreshes news daily (ingest, full texts, tags) and API/worker reload the corpus without restart.
# NEWS_REFRESH_CRON=0 9 * * *
# NEWS_REFRESH_TZ=Europe/Moscow
LLM_MAX_OUTPUT_TOKENS=10000
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=12
# LLM_BASE_URL=https://your-approved-gateway.example/v1
# LLM_API_KEY=
LLM_MODEL_AGENT=deepseek/deepseek-v4.1-flash
LLM_TIMEOUT_MS=30000
# Set ONLY after the gateway operator confirms a hard per-request RUB cap.
# reservation >= (AGENT_MAX_STEPS + 2) * cap; otherwise langgraph startup fails.
# LLM_GATEWAY_REQUEST_CAP_RUB=3
# Production: NODE_ENV=production, HTTPS, configured accounts. DEV_AUTH/fixture forbidden.
