NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://alfa:alfa_local_only@127.0.0.1:5432/alfa
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=alfa
# Explicit local synthetic mode; never use DEV_AUTH on a public deployment.
DEV_AUTH=true
AGENT_PROVIDER=fixture
AUTH_USERS_JSON=[]
DAILY_BUDGET_RUB=500
RUN_RESERVATION_RUB=25
RUN_TIMEOUT_MS=180000
RUN_MAX_RECOVERIES=2
RANKING_LIMIT=3
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=12
# For real data: DEV_AUTH=false, AGENT_PROVIDER=langgraph and server-side accounts.
# AUTH_USERS_JSON=[{"id":"user-id","token":"<random token, at least 32 chars>","companyIds":["dataset-company-id"]}]
# DATA_DIR=/absolute/path/to/data
# LLM_BASE_URL=https://your-approved-gateway.example/v1
# LLM_API_KEY=
LLM_MODEL_AGENT=deepseek/deepseek-v4.1-flash
LLM_TIMEOUT_MS=30000
# Set ONLY after the gateway operator confirms a hard per-request RUB cap.
# reservation >= (AGENT_MAX_STEPS + 2) * cap; otherwise live startup fails.
# LLM_GATEWAY_REQUEST_CAP_RUB=3
