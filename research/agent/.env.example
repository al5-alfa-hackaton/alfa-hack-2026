# OpenAI-compatible endpoint provided by the organizers. Never commit real values.
LLM_BASE_URL=
LLM_API_KEY=
# Exact API model IDs from GET /models (only models from the approved list, PDF p. 18).
LLM_MODEL_AGENT=
# Multimodal model for OCR of the scanned bank PDFs (Qwen3-VL-30B-A3B-Instruct in the list).
LLM_MODEL_VISION=
# Hidden reasoning before the answer: none | low | medium | high. Reasoning costs ~200x more per call.
LLM_REASONING_EFFORT=none
# Hard limits for one agent run.
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=20
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_MS=120000
# Defaults to <repo>/data.
# DATA_DIR=
