{
  "name": "alfa-news-analytics",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @alfa/frontend --filter @alfa/backend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @alfa/backend db:generate",
    "db:migrate": "pnpm --filter @alfa/backend db:migrate",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "ui:add": "pnpm --filter @alfa/frontend exec shadcn add",
    "contracts:generate": "pnpm --filter @alfa/agent build && pnpm --filter @alfa/backend contracts:generate",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code -- packages/api-client/openapi.json packages/api-client/src/schema.d.ts",
    "worker": "pnpm --filter @alfa/backend worker",
    "test:integration": "pnpm --filter @alfa/backend test:integration",
    "db:seed": "pnpm --filter @alfa/backend db:seed",
    "monitor:report": "node --env-file-if-exists=projects/backend/.env scripts/monitor-report.mts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "typescript": "5.9.3"
  }
}
