{
  "name": "alfa-news-analytics",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @alfa/frontend --filter @alfa/backend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @alfa/backend db:generate",
    "db:migrate": "pnpm --filter @alfa/backend db:migrate",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "ui:add": "pnpm --filter @alfa/frontend exec shadcn add"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "^3.9.10",
    "typescript": "5.9.3"
  }
}
